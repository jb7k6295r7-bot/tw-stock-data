#!/usr/bin/env bash
# ⛔ 這個 hook 存在的理由：1 小時 50 分鐘。
#
#   2026-09-10 run 34426373917：「回補」跑了 1h50m 是綠的，
#   「Commit」1 秒失敗——`syntax error: unexpected end of file`，
#   我批次改 workflow 時把 `if/else` 的 closing `fi` 切掉了。
#
#   ⚠ 我當時「驗過」，驗的是 `yaml.safe_load()`——**YAML 合法 ≠ 裡面的 shell 合法**。
#   ⇒ 後來加了 `selftest_workflows.py`，但它排在 **workflow 裡**
#     ——也就是**推出去、按下去、跑起來之後**才會叫。
#   ⛔ 而壞掉的那一刻是在**本機 commit** 的時候。
#
# ⭐ 所以檢查要往前挪到這裡：改到 workflow／`.sh` 就驗，驗不過就不讓 commit。
set -e
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

# ⛔⛔ 第二道（2026-09-10 加）：**同一件事只准有一份實作**。
#   使用者說「同一段邏輯抄兩份、只修一份」已經第三次——往下掃是**十份**，
#   其中一份會讓每日抓取憑空造出一個交易日。
#   ⚠ 這一族**每一次都是在 commit 的當下就已經壞了**，
#     而它要等到「某一天某個市場失敗」才看得出來——所以檢查要在這裡。
#   ⇒ 動到任何 .py 就掃（掃全庫，不只掃改到的那幾支：
#     新增一份拷貝時，改的是新檔，舊檔一個字都沒動）。
if echo "$STAGED" | grep -qE '\.py$'; then
  echo "[pre-commit] 動到 .py ⇒ 掃有沒有第二份實作"
  python3 selftest_no_dup.py >/tmp/_dup.log 2>&1 || {
    echo "⛔ 有函式在不同檔案裡逐字相同，**不讓 commit**："
    grep -E "＝|✗" /tmp/_dup.log | head -20
    echo "   ⇒ 收成一份，另一邊用別名指過去（CLAUDE.md 第四點五）"
    echo "   （要跳過：git commit --no-verify）"
    exit 1
  }
  tail -2 /tmp/_dup.log | head -1
fi

# ⛔⛔ 第三道（2026-09-16 加）：**改到 X.py 就跑 selftest_X.py**。
#
#   代價：2026-09-16 我改了 `official_stats.py` 的一句報表文字，
#   自測印出 `通過 44｜失敗 1`——⚠ 而我**看到了那一行然後照樣 commit 出去**。
#   （紅的原因是那條斷言比的是一句固定的字，語意其實沒變；但那是另一回事：
#     ⛔ 紅了就是要停下來看，不可以帶著紅往下走。）
#
#   ⭐ 而前兩道擋不到它：`selftest_no_dup` 比的是有沒有第二份實作，
#     `selftest_workflows` 只在動到 workflow／`.sh`／新增自測時才跑。
#   ⇒ 這一道只跑**跟這次改動直接對應**的那幾支（⛔ 不是全跑，那會慢到被繞過）。
TESTS=""
NOTEST=""
for f in $STAGED; do
  case "$f" in
    */*) continue ;;                      # ⛔ 只管 repo 根目錄那一層
    selftest_*.py) T="$f" ;;              # 改到自測本身 ⇒ 跑它
    *.py)          T="selftest_${f}" ;;   # 改到 X.py ⇒ 跑 selftest_X.py
    *)             continue ;;
  esac
  # ⛔⛔ 檔名相等這條規則對**兩整族**靜靜什麼都沒做：
  #     `*_probe.py`（14 支）⇒ `selftest_probes.py`
  #     `shares_check.py`     ⇒ `selftest_shares.py`
  #   ⚠ 而它已經付過代價：2026-09-16 我在 `tpex_probe` 寫了第二份去標籤，
  #     `selftest_probes.py` ⑭ 抓得到，⛔ 而這裡印「這一層沒跑」⇒ 我照樣 commit。
  #   ⇒ ⭐ 對應不到就問**資料自己**：哪幾支自測 import 了它（AST）。
  #     ⛔ 不是我在這裡維護一張對照表——那是「改一邊、另一邊沒跟上」的完美條件。
  if [ ! -f "$T" ]; then
    # ⛔ **全部都跑，不是 head -1**：一支模組可能被兩支自測沾到，
    #   ⚠ 而只取第一支會挑到「只掃原始碼」那種弱的（`selftest_ca_chain.py`）
    #   ⇒ 那會印出綠的，而真正測它的那支一次都沒跑（四點二：綠燈證明的是哪一件事）。
    T2=$(python3 selftest_workflows.py --tests-for "$f" 2>/dev/null)
    if [ -z "$T2" ]; then NOTEST="$NOTEST $f"; continue; fi
    for X in $T2; do
      [ -f "$X" ] || continue
      case " $TESTS " in *" $X "*) continue ;; esac
      TESTS="$TESTS $X"
    done
    continue
  fi
  case " $TESTS " in *" $T "*) continue ;; esac
  TESTS="$TESTS $T"
done
# ⛔ 對應不到自測的那幾支要**大聲講出來**（六點五：條件不成立就印「這一層沒跑」）。
#   ⚠ 這一族的命名不是一對一：`shares_check.py` 的自測叫 `selftest_shares.py`
#     ⇒ 這條規則對它**靜靜什麼都沒做**，而「沒跑」與「跑過了全綠」在畫面上一樣。
#   ⛔ 不算失敗：很多檔本來就沒有自測，寫成斷言會擋掉每一次 commit。
if [ -n "$NOTEST" ]; then
  echo "[pre-commit] ⚠ **這一層沒跑**（對應不到 selftest_<檔名>.py）：$NOTEST"
fi
if [ -n "$TESTS" ]; then
  echo "[pre-commit] 動到的程式有對應自測 ⇒ 跑：$TESTS"
  BAD=""
  for T in $TESTS; do
    # ⚠ 逐一跑並記下失敗，⛔ 不是「一個壞就整批不跑」（四點二⑥那條）
    if timeout 180 python3 "$T" >"/tmp/_st_$$.log" 2>&1; then
      :
    else
      RC=$?
      BAD="$BAD $T"
      echo "⛔ $T 沒過（rc=$RC）："
      # ⛔ 印 tail 是錯的：後面可能全是 ok。只印 ✗ 那幾行與最後一行統計。
      grep -E "^\s*✗|Traceback|Error" "/tmp/_st_$$.log" | head -12
      tail -1 "/tmp/_st_$$.log"
    fi
    rm -f "/tmp/_st_$$.log"
  done
  if [ -n "$BAD" ]; then
    echo "   ⇒ 這幾支自測是紅的，**不讓 commit**：$BAD"
    echo "   ⚠ 若確定是斷言本身過時（例如它比的是一句固定的字），"
    echo "     ⛔ 也要**先改斷言**再 commit——不可以帶著紅往下走。"
    echo "   （要跳過：git commit --no-verify）"
    exit 1
  fi
fi

# ⛔ 第四道（2026-09-10 加）：**新增一支自測，也要驗 workflow。**
#   `selftest_workflows.py` 現在多一條「每一支 selftest_*.py 都要有人跑它」——
#   ⚠ 而觸發它的時機正是**新增自測的那一刻**，⛔ 不是改 workflow 的那一刻。
#   （`selftest_reduce.py` 就是這樣紅著沒人知道：它從來沒被列進任何 workflow。）
echo "$STAGED" | grep -qE '^\.github/workflows/.*\.ya?ml$|\.sh$|(^|/)selftest_[^/]*\.py$' || exit 0
echo "[pre-commit] 動到 workflow／shell／自測 ⇒ 驗語法＋驗每支自測都有人跑"
python3 selftest_workflows.py >/tmp/_wf.log 2>&1 || {
  echo "⛔ workflow／shell 語法沒過，**不讓 commit**："
  # ⛔ 印 tail 是錯的：後面全是 ok，真正的 ✗ 會被埋掉。
  #   ⚠ 一個「擋得下來但看不出為什麼」的守門，跟沒有守門差不多——
  #     人會直接 --no-verify 繞過去。⇒ 只印 ✗ 那幾行。
  grep -E "^  ✗|失敗" /tmp/_wf.log | head -20
  echo "   （要跳過：git commit --no-verify，⚠ 但那正是 1h50m 的來源）"
  exit 1
}
tail -1 /tmp/_wf.log
