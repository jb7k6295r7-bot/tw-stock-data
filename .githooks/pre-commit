#!/usr/bin/env bash
# ⛔ 這個 hook 存在的理由：1 小時 50 分鐘。
#
#   2026-09-10 run 34426373917：「回補」跑了 1h50m 是綠的，
#   「Commit」1 秒失敗——`syntax error: unexpected end of file`，
#   我批次改 workflow 時把 `if/else` 的 closing `fi` 切掉了。
#
#   ⚠ 我當時「驗過」，驗的是 `yaml.safe_load()`——**YAML 合法 ≠ 裡面的 shell 合法**。
#   ⇒ 後來加了 `selftest_workflows.py`，但它排在 **workflow 裡**
#     ——也就是**推出去、按下去、跑起來之後**才會叫。
#   ⛔ 而壞掉的那一刻是在**本機 commit** 的時候。
#
# ⭐ 所以檢查要往前挪到這裡：改到 workflow／`.sh` 就驗，驗不過就不讓 commit。
set -e
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

# ⛔⛔ 第二道（2026-09-10 加）：**同一件事只准有一份實作**。
#   使用者說「同一段邏輯抄兩份、只修一份」已經第三次——往下掃是**十份**，
#   其中一份會讓每日抓取憑空造出一個交易日。
#   ⚠ 這一族**每一次都是在 commit 的當下就已經壞了**，
#     而它要等到「某一天某個市場失敗」才看得出來——所以檢查要在這裡。
#   ⇒ 動到任何 .py 就掃（掃全庫，不只掃改到的那幾支：
#     新增一份拷貝時，改的是新檔，舊檔一個字都沒動）。
if echo "$STAGED" | grep -qE '\.py$'; then
  echo "[pre-commit] 動到 .py ⇒ 掃有沒有第二份實作"
  python3 selftest_no_dup.py >/tmp/_dup.log 2>&1 || {
    echo "⛔ 有函式在不同檔案裡逐字相同，**不讓 commit**："
    grep -E "＝|✗" /tmp/_dup.log | head -20
    echo "   ⇒ 收成一份，另一邊用別名指過去（CLAUDE.md 第四點五）"
    echo "   （要跳過：git commit --no-verify）"
    exit 1
  }
  tail -2 /tmp/_dup.log | head -1
fi

# ⛔ 第三道（2026-09-10 加）：**新增一支自測，也要驗 workflow。**
#   `selftest_workflows.py` 現在多一條「每一支 selftest_*.py 都要有人跑它」——
#   ⚠ 而觸發它的時機正是**新增自測的那一刻**，⛔ 不是改 workflow 的那一刻。
#   （`selftest_reduce.py` 就是這樣紅著沒人知道：它從來沒被列進任何 workflow。）
echo "$STAGED" | grep -qE '^\.github/workflows/.*\.ya?ml$|\.sh$|(^|/)selftest_[^/]*\.py$' || exit 0
echo "[pre-commit] 動到 workflow／shell／自測 ⇒ 驗語法＋驗每支自測都有人跑"
python3 selftest_workflows.py >/tmp/_wf.log 2>&1 || {
  echo "⛔ workflow／shell 語法沒過，**不讓 commit**："
  # ⛔ 印 tail 是錯的：後面全是 ok，真正的 ✗ 會被埋掉。
  #   ⚠ 一個「擋得下來但看不出為什麼」的守門，跟沒有守門差不多——
  #     人會直接 --no-verify 繞過去。⇒ 只印 ✗ 那幾行。
  grep -E "^  ✗|失敗" /tmp/_wf.log | head -20
  echo "   （要跳過：git commit --no-verify，⚠ 但那正是 1h50m 的來源）"
  exit 1
}
tail -1 /tmp/_wf.log
